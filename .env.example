# Firebase config — copy this file to .env and fill in the values
# from Firebase Console > Project settings > Your web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — App Check (Firebase Console > App Check > reCAPTCHA Enterprise)
# Without this the site still works; with it, unverified clients are rejected
# once you enable "Enforce" in the App Check console.
VITE_RECAPTCHA_SITE_KEY=